{
  "expo": {
    "name": "Fridgy",
    "slug": "fridgy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fridgy",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F7F5",
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F5"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
